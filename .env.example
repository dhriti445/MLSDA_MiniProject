# Copy to .env. Nothing here is committed with real values (D4).
# --- LLM provider: "heuristic" runs with no model at all; "openai" = any OpenAI-compatible endpoint
LLM_PROVIDER=heuristic
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
PRICE_IN_PER_1K=0
PRICE_OUT_PER_1K=0
LLM_TIMEOUT_S=20
LLM_MAX_RETRIES=3
BREAKER_THRESHOLD=3
BREAKER_COOLDOWN_S=30
# --- agent bounds
MAX_STEPS=26
MAX_TOOL_CALLS=22
RUN_TIMEOUT_S=60
MAX_VERIFY_RETRIES=1
PROMPT_VERSION=v1
# --- service
REDIS_URL=redis://redis:6379/0
RATE_LIMIT_PER_MIN=30
CACHE_TTL_S=3600
GRAFANA_ADMIN_PASSWORD=change-me
# --- load test stub
STUB_DELAY_MS=800
